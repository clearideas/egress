# Scripts run inside Linux containers and sandboxes: keep LF even on Windows checkouts
# (a CRLF entrypoint fails with "set: illegal option -").
*.sh        text eol=lf
Dockerfile  text eol=lf
Dockerfile.* text eol=lf
*.py        text eol=lf
*.conf      text eol=lf
*.template  text eol=lf
*.nft       text eol=lf
