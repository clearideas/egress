{
  "title": "Egress proxy",
  "uid": "egress-proxy",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "egress",
    "security"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ready replicas",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(egress_ready)",
          "legendFormat": "ready"
        },
        {
          "refId": "B",
          "expr": "count(egress_ready)",
          "legendFormat": "total"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Squid up",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(egress_squid_up)",
          "legendFormat": "up"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests/s (Squid)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(egress_squid_client_requests_total[5m]))",
          "legendFormat": "requests"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Decision failure ratio",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(egress_decisions_total{reason=~\"backend_error|backend_timeout|backend_saturated\"}[5m])) / clamp_min(sum(rate(egress_decisions_total[5m])), 1e-9)",
          "legendFormat": "failures"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Decisions by outcome",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (decision, reason) (rate(egress_decisions_total[5m]))",
          "legendFormat": "{{decision}} {{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Decisions: cached approvals vs backend calls",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (rate(egress_decisions_total[5m]))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Policy decision latency",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(egress_policy_decision_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(egress_policy_decision_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Policy API attempts and retries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(egress_policy_api_attempts_total[5m]))",
          "legendFormat": "attempts"
        },
        {
          "refId": "B",
          "expr": "sum(rate(egress_policy_api_retries_total[5m]))",
          "legendFormat": "retries"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Egress volume",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(egress_squid_client_bytes_total[5m]))",
          "legendFormat": "{{direction}}"
        },
        {
          "refId": "B",
          "expr": "sum by (direction) (rate(egress_squid_server_bytes_total[5m]))",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Helper queues",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (helper) (egress_helper_pool_queue_length)",
          "legendFormat": "{{helper}} queue"
        },
        {
          "refId": "B",
          "expr": "max by (helper) (egress_helper_pool_service_seconds)",
          "legendFormat": "{{helper}} avg s"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Security signals",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(egress_signatures_total{decision=\"deny\"}[5m]))",
          "legendFormat": "signature {{reason}}"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (increase(egress_tls_checks_total{decision=\"deny\"}[5m]))",
          "legendFormat": "tls {{reason}}"
        },
        {
          "refId": "C",
          "expr": "sum by (reason) (increase(egress_auth_total{decision=\"deny\"}[5m]))",
          "legendFormat": "auth {{reason}}"
        },
        {
          "refId": "D",
          "expr": "sum by (reason) (increase(egress_request_checks_total{decision=\"deny\"}[5m]))",
          "legendFormat": "request {{reason}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Approval cache",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(egress_approval_cache_hits_total[5m]))",
          "legendFormat": "hits"
        },
        {
          "refId": "B",
          "expr": "sum(rate(egress_approval_cache_misses_total[5m]))",
          "legendFormat": "misses"
        },
        {
          "refId": "C",
          "expr": "sum(egress_approval_cache_keys)",
          "legendFormat": "keys"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "File descriptors",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (egress_squid_file_descriptors)",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Credential injections and config reloads",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rule) (rate(egress_credential_injections_total[5m]))",
          "legendFormat": "inject {{rule}}"
        },
        {
          "refId": "B",
          "expr": "sum by (result) (increase(egress_config_reloads_total[1h]))",
          "legendFormat": "reload {{result}}"
        }
      ]
    }
  ]
}
