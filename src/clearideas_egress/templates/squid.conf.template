# Generated by clearideas-egress-render. Do not edit; change EGRESS_* settings instead.
#
# Rule-ordering invariants (enforced by tests/unit/test_template.py):
#  1. Nothing that needs DNS (dst, to_localhost) runs before authentication and the
#     policy decision, so unauthorized names are never resolved (review C-1).
#  2. Helper-backed ACLs (policy_allowed, sni_ok) are used only in positive form on
#     allow/splice lines. Squid *ignores* such an ACL when its helper queue overflows,
#     so a negated or deny-line use could fail open (review H-3).
#  3. The cache manager is denied before anything else (review H-4).

visible_hostname $visible_hostname
$listeners
pid_filename $run_dir/squid.pid
coredump_dir $run_dir
cache deny all
# On SIGTERM Squid stops accepting connections and lets active ones finish for this long.
shutdown_lifetime $shutdown_lifetime seconds
max_filedescriptors $max_filedescriptors

# --- logging (review M-6) ---------------------------------------------------
# String fields use %# (URL) encoding so every record is valid JSON.
logformat egress_json {"ts":"%{%Y-%m-%dT%H:%M:%S}tg.%03tuZ","client":"%>a","principal":"%#un","method":"%#rm","url":"%#ru","status":"%>Hs","result":"%Ss","hierarchy":"%Sh","server":"%<a","bytes_from_client":"%>st","bytes_to_client":"%<st","duration_ms":"%tr","sni":"%#ssl::>sni","decision":"%#ea","destination":"%#{egress_dest_}note","decision_id":"%#{egress_decision_}note","xaction":"%master_xaction","instance":"$instance_id"}
access_log $access_log egress_json
cache_log $cache_log
logfile_rotate 0
strip_query_terms on

# --- hardening (review M-4) ---------------------------------------------------
httpd_suppress_version_string on
# The proxy's own error pages (errorpages.py): they say the egress proxy answered, and why.
error_directory $run_dir/errors
relaxed_header_parser off
email_err_data off
uri_whitespace deny
via off
forwarded_for delete
follow_x_forwarded_for deny all
request_header_access Proxy-Authorization deny all
# Signed identity headers never leave the proxy.
$strip_identity_headers
reply_header_access X-Squid-Error deny all
reply_header_access X-Cache deny all
reply_header_access X-Cache-Lookup deny all
reply_header_access Server deny all
$cachemgr_actions
cachemgr_passwd disable all
dns_defnames off
icp_port 0
htcp_port 0
$dns_nameservers
$pinger
# --- limits (review M-5) ------------------------------------------------------
request_body_max_size $request_body_max_size
client_lifetime $client_lifetime seconds
read_timeout $read_timeout seconds
request_timeout $request_timeout seconds
request_start_timeout $request_timeout seconds
connect_timeout $connect_timeout seconds
# Upload *rate* limiting is not done here: Squid 6 client_delay_pools did not throttle
# request bodies in testing. Shape bandwidth at the network layer (see docs).
# --- authentication (review H-2) ----------------------------------------------
$auth
# --- policy decision ------------------------------------------------------------
$policy_acls
acl SSL_ports port 443
acl Safe_ports port 80
acl Safe_ports port 443
acl CONNECT method CONNECT
acl http_proto proto HTTP
acl web_proto proto HTTP HTTPS
acl private_dst dst "$run_dir/deny-cidrs.conf"
$proxy_protocol
$access_rules
$tls
$upstream_tls
$credentials
$extra
